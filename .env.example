# Cloudinary configuration for PosterPilot
# Copy this file to .env.local and fill in your real Cloudinary Cloud Name.
#
# SECURITY: Only unsigned uploads are used. Never place the Cloudinary API Secret here.
# These values are exposed to the browser (that is expected for unsigned uploads).

# Your Cloudinary cloud name (found in your Cloudinary dashboard).
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name_here

# The unsigned upload preset (already created in your Cloudinary account).
VITE_CLOUDINARY_UPLOAD_PRESET=posterpilot_unsigned
